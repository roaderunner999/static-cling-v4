# Static Cling v4 — environment template.
# Copy to .env.local for development:  cp .env.example .env.local
# Production values live on the DigitalOcean droplet's environment / systemd
# unit — never commit real secrets to this file.

# Postgres connection string.
# Local dev  -> staticcling_dev
# Production -> staticcling_v4 (local Postgres on the DO droplet; PgBouncer
#               deferred until traffic warrants it)
DATABASE_URL="postgresql://user:password@localhost:5432/staticcling_dev"

# --- Better Auth (Stage 1) ---
# Signs sessions/tokens. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET="generate-me-with-openssl-rand-base64-32"
# Public base URL. Dev: http://localhost:3000  Prod: https://static-cling.com
BETTER_AUTH_URL="http://localhost:3000"

# --- Admin console ---
# Comma-separated emails that always have admin access (in addition to anyone
# whose user.role is 'admin'). Safety net so the owner can't be locked out.
ADMIN_EMAILS="admin@lyons.net"

# --- Optional providers (leave blank until you have keys) ---
# Google OAuth — social sign-in activates automatically when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Resend — transactional email (magic links, verification, password reset).
# Email-backed flows activate when RESEND_API_KEY is set.
RESEND_API_KEY=""
EMAIL_FROM="Static Cling <onboarding@static-cling.com>"

# Stripe billing (Stage 2). Billing activates when SECRET_KEY + PRICE_ID are set.
# Dev = test-mode keys (sk_test_… / price_… from a test product). See STAGE-2-BILLING.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# --- Claude chat (Stage 3) ---
# Server-side Anthropic API key (sk-ant-…). Chat activates when set.
ANTHROPIC_API_KEY=""

# --- Voice output (ElevenLabs, premium TTS) ---
# Optional. Voice INPUT (dictation) and free native voice OUTPUT work with NO
# key — they're 100% browser-native. Set this only to add the premium ElevenLabs
# voice as a toggle in chat. The key stays server-side (never reaches the browser).
ELEVENLABS_API_KEY=""
# Voice to speak in (a voice_id from your ElevenLabs library). Default = "Rachel".
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
# Model: turbo = low latency (the snappy pick). eleven_multilingual_v2 = max fidelity.
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"
